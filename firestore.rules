rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Everyone can read the league. Only scorekeepers can write.
// A scorekeeper is anyone with a doc at scorekeepers/{their sign-in email, lowercase}.
// Name/password scorekeepers sign in as <name>@knee-hockey.invalid, so their doc ID is that.
// Add those docs by hand in the console (Data tab). No email is ever stored in this public repo.
service cloud.firestore {
  match /databases/{database}/documents {
    function scorekeeper() {
      return request.auth != null
        // Google accounts must have a verified email. Name/password accounts can only be created
        // by Alex in the console (self sign-up is turned off), so they're trusted without one.
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'password')
        && exists(/databases/$(database)/documents/scorekeepers/$(request.auth.token.email.lower()));
    }

    match /teams/{id}       { allow read: if true; allow write: if scorekeeper(); }
    match /games/{id}       { allow read: if true; allow write: if scorekeeper(); }
    match /tournaments/{id} { allow read: if true; allow write: if scorekeeper(); }
    match /meta/{id}        { allow read: if true; allow write: if scorekeeper(); }

    // Each person can only check their own entry. Nobody can list or change it from the site.
    match /scorekeepers/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }
  }
}
